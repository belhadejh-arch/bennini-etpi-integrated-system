{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "Financial cashflow operation recording income or expense.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["دخل", "مصروف"] },
        "amount": { "type": "number" },
        "party": { "type": "string" },
        "reason": { "type": "string" },
        "date": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["نقداً", "شيك", "تحويل بنكي"] },
        "balanceAfter": { "type": "number" },
        "notes": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "receiptName": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "amount", "party", "reason", "paymentMethod", "createdBy"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Procured material or inventory commodity.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "buyPrice": { "type": "number" },
        "totalCost": { "type": "number" },
        "supplier": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "sellPrice": { "type": "number" },
        "expectedProfit": { "type": "number" },
        "realizedProfit": { "type": "number" },
        "remainingQuantity": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "notes": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "quantity", "buyPrice", "totalCost", "supplier", "createdBy"]
    },
    "Cheque": {
      "title": "Cheque",
      "description": "Cheque tracking record with related invoice.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chequeNumber": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "amount": { "type": "number" },
        "beneficiary": { "type": "string" },
        "bank": { "type": "string" },
        "issueDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string", "enum": ["قيد الانتظار", "مدفوع", "ملغى"] },
        "notes": { "type": "string" },
        "chequeImageUrl": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": [
        "chequeNumber",
        "amount",
        "beneficiary",
        "bank",
        "dueDate",
        "status",
        "createdBy"
      ]
    },
    "Rental": {
      "title": "Rental",
      "description": "Equipment and machinery rental lease agreement.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "equipment": { "type": "string" },
        "clientOrOwner": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "duration": { "type": "string" },
        "rate": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["نشط", "ينتهي قريباً", "مكتمل"] },
        "notes": { "type": "string" },
        "contractUrl": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": [
        "equipment",
        "clientOrOwner",
        "startDate",
        "endDate",
        "totalAmount",
        "status",
        "createdBy"
      ]
    },
    "Machinery": {
      "title": "Machinery",
      "description": "Vehicles, excavators, and industrial machinery.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": "string" },
        "plateNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["تعمل بكفاءة", "في الصيانة", "متوقفة"] },
        "assignedSite": { "type": "string" },
        "totalRepairExpenses": { "type": "number" },
        "fuelConsumptionRate": { "type": "string" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "model", "status", "createdBy"]
    },
    "SparePart": {
      "title": "SparePart",
      "description": "Spare parts catalog and machinery installation logs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "buyPrice": { "type": "number" },
        "supplier": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "machineryId": { "type": "string" },
        "machineryName": { "type": "string" },
        "installedDate": { "type": "string" },
        "remainingStock": { "type": "number" },
        "repairExpenses": { "type": "number" },
        "notes": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "buyPrice", "machineryName", "createdBy"]
    },
    "FieldExpense": {
      "title": "FieldExpense",
      "description": "Direct site expenses logged by site foreman from mobile.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["مازوت وقود", "قطع غيار", "مشتريات ميدانية", "إصلاح آلية", "أجور سريعة", "أخرى"]
        },
        "amount": { "type": "number" },
        "fuelLiters": { "type": "number" },
        "siteName": { "type": "string" },
        "details": { "type": "string" },
        "notes": { "type": "string" },
        "receiptPhotoUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["معلق للمراجعة", "معتمد", "مرفوض"] },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["category", "amount", "siteName", "createdBy"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System-wide immutable audit trail for security and transparency.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userName": { "type": "string" },
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "section": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userName", "action", "section", "details", "timestamp"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and fine-grained access control permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "canViewFinance": { "type": "boolean" },
        "canEditFinance": { "type": "boolean" },
        "canViewInventory": { "type": "boolean" },
        "canEditInventory": { "type": "boolean" },
        "canViewCheques": { "type": "boolean" },
        "canEditCheques": { "type": "boolean" },
        "canViewRentals": { "type": "boolean" },
        "canEditRentals": { "type": "boolean" },
        "canViewMachinery": { "type": "boolean" },
        "canEditMachinery": { "type": "boolean" },
        "canViewFieldPortal": { "type": "boolean" },
        "canManageUsers": { "type": "boolean" },
        "canDeleteRecords": { "type": "boolean" },
        "canUploadFiles": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "System alerts and urgent notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["cheque", "rental", "stock", "fieldExpense", "system"]
        },
        "targetSection": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "message", "type", "isRead"]
    }
  },
  "firestore": {
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Financial income and expense transactions."
    },
    "/inventory/{inventoryId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Materials and equipment inventory items."
    },
    "/cheques/{chequeId}": {
      "schema": { "$ref": "#/entities/Cheque" },
      "description": "Cheques issued or received."
    },
    "/rentals/{rentalId}": {
      "schema": { "$ref": "#/entities/Rental" },
      "description": "Rental contracts for heavy machinery."
    },
    "/machinery/{machineryId}": {
      "schema": { "$ref": "#/entities/Machinery" },
      "description": "Heavy machinery fleet and equipment details."
    },
    "/spareParts/{sparePartId}": {
      "schema": { "$ref": "#/entities/SparePart" },
      "description": "Spare parts log and vehicle repair linking."
    },
    "/fieldExpenses/{expenseId}": {
      "schema": { "$ref": "#/entities/FieldExpense" },
      "description": "Field expenses logged by site foreman from mobile."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Central system audit log trail."
    },
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User accounts with permission matrices."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "System notices and urgency alerts."
    }
  }
}
