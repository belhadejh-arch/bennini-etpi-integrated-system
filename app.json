{
  "expo": {
    "name": "Bennini ETPI",
    "slug": "bennini-etpi",
    "scheme": "benninietpi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./app/assets/app-icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/brand-mark-cropped.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#0B3F98",
          "dark": { "backgroundColor": "#0B3F98" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.benninietpi.app",
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/brand-mark-transparent.png",
        "backgroundColor": "#0B3F98"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./public/favicon.png"
    }
  }
}
