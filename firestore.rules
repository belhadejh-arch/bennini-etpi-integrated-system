rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all requests
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.type in ['دخل', 'مصروف'];
      allow update, delete: if isSignedIn();
    }

    // Inventory Collection
    match /inventory/{inventoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Cheques Collection
    match /cheques/{chequeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Rentals Collection
    match /rentals/{rentalId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Machinery Collection
    match /machinery/{machineryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Spare Parts Collection
    match /spareParts/{sparePartId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Field Expenses Collection
    match /fieldExpenses/{expenseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Central Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Audit logs are immutable
    }

    // User Profiles Collection
    match /userProfiles/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.accountCategory in ['staff', 'worker'] &&
        request.resource.data.canManageUsers == false &&
        request.resource.data.canDeleteRecords == false
      );
      allow update, delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
